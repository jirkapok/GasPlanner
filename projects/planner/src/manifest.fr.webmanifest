{
  "name": "Dugong Planificateur de Gaz",
  "short_name": "Planificateur de Gaz",
  "description": "Calculatrice simple de planification de gaz de plongée. Calcule la décompression et la remontée selon le modèle Bühlmann ZHL-16.",
  "categories": [
    "utilities",
    "sports",
    "education",
    "navigation"
  ],
  "theme_color": "#1976d2",
  "background_color": "#fafafa",
  "lang": "fr",
  "dir": "ltr",
  "display": "standalone",
  "id": "0.6.2",
  "scope": "./",
  "start_url": "./",
  "orientation": "portrait-primary",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "shortcuts": [
    {
      "name": "Calculatrice Nitrox",
      "url": "/nitrox"
    },
    {
      "name": "Calculatrice Sac/RMV",
      "url": "/sac"
    },
    {
      "name": "Calculatrice des limites sans décompression",
      "url": "/ndl"
    }
  ],
